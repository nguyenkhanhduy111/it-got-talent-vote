# Sao chép thành .env (KHÔNG commit). Không chứa bí mật thật.
PORT=3000
HOST=0.0.0.0
# URL công khai HTTPS mà điện thoại truy cập; mã QR sẽ trỏ tới  <PUBLIC_URL>/vote
PUBLIC_URL=https://vote.example.com
# Đặt 1 nếu chạy sau reverse proxy / Cloudflare Tunnel (để lấy IP thật cho giới hạn thử mã)
TRUST_PROXY=1
# Mật khẩu quản trị viên (bắt buộc đặt). Nếu bỏ trống, hệ thống tự sinh và in ra console.
ADMIN_PASSWORD=
# Mật khẩu "vận hành sân khấu" (chỉ điều khiển LED/âm thanh/công bố). Bỏ trống = tắt tài khoản này.
OPERATOR_PASSWORD=
# Các khóa dưới đây để trống thì tự sinh và lưu ở DATA_DIR/.secrets.json — HÃY SAO LƯU THƯ MỤC data/.
# Mất CODE_PEPPER = mọi mã tham dự đã cấp thành vô hiệu.
SESSION_SECRET=
CODE_PEPPER=
SCREEN_KEY=
DATA_DIR=./data
